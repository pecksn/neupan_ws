<launch>
  <arg name="image_topic" default="/camera/rgb/image_raw" />
  <arg name="input_path_topic" default="/osm_global_path" />
  <arg name="output_path_topic" default="/osm_global_path_refined" />
  <arg name="enable_path_refine" default="true" />

  <!-- HSV defaults target low-saturation asphalt/gray road regions. Tune in rqt_reconfigure-style by relaunching. -->
  <arg name="roi_top_ratio" default="0.45" />
  <arg name="h_min" default="0" />
  <arg name="h_max" default="179" />
  <arg name="s_min" default="0" />
  <arg name="s_max" default="90" />
  <arg name="v_min" default="35" />
  <arg name="v_max" default="245" />
  <arg name="min_area_ratio" default="0.015" />
  <arg name="max_correction_m" default="0.8" />
  <arg name="process_rate" default="10.0" />

  <node pkg="road_vision_refinement" type="road_vision_node.py" name="road_vision" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="roi_top_ratio" value="$(arg roi_top_ratio)" />
    <param name="h_min" value="$(arg h_min)" />
    <param name="h_max" value="$(arg h_max)" />
    <param name="s_min" value="$(arg s_min)" />
    <param name="s_max" value="$(arg s_max)" />
    <param name="v_min" value="$(arg v_min)" />
    <param name="v_max" value="$(arg v_max)" />
    <param name="min_area_ratio" value="$(arg min_area_ratio)" />
    <param name="max_correction_m" value="$(arg max_correction_m)" />
    <param name="process_rate" value="$(arg process_rate)" />
  </node>

  <group if="$(arg enable_path_refine)">
    <node pkg="road_vision_refinement" type="path_refine_node.py" name="road_path_refine" output="screen">
      <param name="input_path_topic" value="$(arg input_path_topic)" />
      <param name="output_path_topic" value="$(arg output_path_topic)" />
      <param name="error_topic" value="/road_vision/lateral_error" />
      <param name="max_shift_m" value="$(arg max_correction_m)" />
      <param name="filter_alpha" value="0.2" />
      <param name="invert_error" value="false" />
    </node>
  </group>
</launch>
