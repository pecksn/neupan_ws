<launch>
  <!-- One-command debug stack. Disable either producer when it is already running elsewhere. -->
  <arg name="start_camera" default="true" />
  <arg name="start_image_proc" default="true" />
  <arg name="start_debug_viewers" default="false" />
  <arg name="echo_status" default="true" />
  <arg name="camera_color_info_uri" default="file://$(find road_vision_refinement)/config/calibration/astra_rgb_camera.yaml" />
  <arg name="camera_enable_depth" default="true" />
  <arg name="image_topic" default="/camera/rgb/image_rect_color" />
  <arg name="ipm_matrix_file" default="$(find road_vision_refinement)/config/calibration/ipm_points.json" />
  <arg name="input_path_topic" default="/osm_global_path" />
  <arg name="output_path_topic" default="/osm_global_path_refined" />
  <arg name="enable_path_refine" default="false" />

  <!-- HSV defaults target low-saturation asphalt/gray road regions. Tune in rqt_reconfigure-style by relaunching. -->
  <arg name="roi_top_ratio" default="0.45" />
  <arg name="h_min" default="0" />
  <arg name="h_max" default="179" />
  <arg name="s_min" default="0" />
  <arg name="s_max" default="90" />
  <arg name="v_min" default="35" />
  <arg name="v_max" default="245" />
  <arg name="min_area_ratio" default="0.015" />
  <arg name="max_correction_m" default="0.8" />
  <arg name="process_rate" default="10.0" />
  <!-- auto: prefer center line, then fall back to road-region center. -->
  <arg name="target_mode" default="auto" />
  <arg name="center_line_right_offset_ratio" default="0.18" />
  <arg name="road_edge_clearance_ratio" default="0.18" />
  <arg name="road_min_scanline_count" default="3" />
  <arg name="road_min_bottom_touch_ratio" default="0.92" />
  <!-- +1 assumes forward motion with camera optical right = vehicle right; -1 reverses it. -->
  <arg name="center_line_right_sign" default="1.0" />
  <!-- Hold the last visual target briefly, then fade back to the map path. -->
  <arg name="invalid_hold_sec" default="1.0" />
  <arg name="invalid_decay_alpha" default="0.08" />
  <arg name="min_confidence" default="0.35" />
  <arg name="min_line_confidence" default="0.40" />
  <arg name="center_line_requires_road" default="true" />
  <arg name="line_max_jump_px" default="70.0" />
  <arg name="line_max_angle_jump_deg" default="25.0" />
  <arg name="line_smoothing_alpha" default="0.25" />
  <arg name="line_confirm_frames" default="3" />
  <arg name="center_line_expected_x_ratio" default="0.40" />
  <arg name="center_line_max_offset_ratio" default="0.32" />
  <!-- For a vehicle on the right side, the center line normally converges from left-bottom toward the image center. -->
  <arg name="center_line_slope_sign" default="-1.0" />
  <arg name="center_line_max_eval_x_ratio" default="0.62" />
  <arg name="white_s_max" default="75" />
  <arg name="white_v_min" default="175" />
  <arg name="yellow_h_min" default="15" />
  <arg name="yellow_h_max" default="42" />
  <arg name="yellow_s_min" default="60" />
  <arg name="yellow_v_min" default="70" />

  <include if="$(arg start_camera)" file="$(find astra_camera)/launch/astra_pro_plus.launch">
    <arg name="depth_align" value="$(arg camera_enable_depth)" />
    <arg name="enable_depth" value="$(arg camera_enable_depth)" />
    <arg name="enable_ir" value="false" />
    <arg name="enable_point_cloud" value="false" />
    <arg name="color_info_uri" value="$(arg camera_color_info_uri)" />
  </include>

  <group if="$(arg start_image_proc)" ns="camera/rgb">
    <node pkg="image_proc" type="image_proc" name="image_proc" output="screen" />
  </group>

  <node pkg="road_vision_refinement" type="road_vision_node.py" name="road_vision" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="ipm_matrix_file" value="$(arg ipm_matrix_file)" />
    <param name="print_status" value="$(arg echo_status)" />
    <param name="roi_top_ratio" value="$(arg roi_top_ratio)" />
    <param name="h_min" value="$(arg h_min)" />
    <param name="h_max" value="$(arg h_max)" />
    <param name="s_min" value="$(arg s_min)" />
    <param name="s_max" value="$(arg s_max)" />
    <param name="v_min" value="$(arg v_min)" />
    <param name="v_max" value="$(arg v_max)" />
    <param name="min_area_ratio" value="$(arg min_area_ratio)" />
    <param name="max_correction_m" value="$(arg max_correction_m)" />
    <param name="process_rate" value="$(arg process_rate)" />
    <param name="target_mode" value="$(arg target_mode)" />
    <param name="center_line_right_offset_ratio" value="$(arg center_line_right_offset_ratio)" />
    <param name="road_edge_clearance_ratio" value="$(arg road_edge_clearance_ratio)" />
    <param name="road_min_scanline_count" value="$(arg road_min_scanline_count)" />
    <param name="road_min_bottom_touch_ratio" value="$(arg road_min_bottom_touch_ratio)" />
    <param name="center_line_right_sign" value="$(arg center_line_right_sign)" />
    <param name="invalid_hold_sec" value="$(arg invalid_hold_sec)" />
    <param name="min_confidence" value="$(arg min_confidence)" />
    <param name="min_line_confidence" value="$(arg min_line_confidence)" />
    <param name="center_line_requires_road" value="$(arg center_line_requires_road)" />
    <param name="line_max_jump_px" value="$(arg line_max_jump_px)" />
    <param name="line_max_angle_jump_deg" value="$(arg line_max_angle_jump_deg)" />
    <param name="line_smoothing_alpha" value="$(arg line_smoothing_alpha)" />
    <param name="line_confirm_frames" value="$(arg line_confirm_frames)" />
    <param name="center_line_expected_x_ratio" value="$(arg center_line_expected_x_ratio)" />
    <param name="center_line_max_offset_ratio" value="$(arg center_line_max_offset_ratio)" />
    <param name="center_line_slope_sign" value="$(arg center_line_slope_sign)" />
    <param name="center_line_max_eval_x_ratio" value="$(arg center_line_max_eval_x_ratio)" />
    <param name="white_s_max" value="$(arg white_s_max)" />
    <param name="white_v_min" value="$(arg white_v_min)" />
    <param name="yellow_h_min" value="$(arg yellow_h_min)" />
    <param name="yellow_h_max" value="$(arg yellow_h_max)" />
    <param name="yellow_s_min" value="$(arg yellow_s_min)" />
    <param name="yellow_v_min" value="$(arg yellow_v_min)" />
  </node>

  <group if="$(arg start_debug_viewers)">
    <node pkg="image_view" type="image_view" name="road_debug_view" output="screen">
      <remap from="image" to="/road_vision/debug_image" />
      <param name="autosize" value="true" />
    </node>
    <node pkg="image_view" type="image_view" name="center_line_mask_view" output="screen">
      <remap from="image" to="/road_vision/center_line_mask" />
      <param name="autosize" value="true" />
    </node>
    <node pkg="image_view" type="image_view" name="road_mask_view" output="screen">
      <remap from="image" to="/road_vision/road_mask" />
      <param name="autosize" value="true" />
    </node>
  </group>

  <group if="$(arg enable_path_refine)">
    <node pkg="road_vision_refinement" type="path_refine_node.py" name="road_path_refine" output="screen">
      <param name="input_path_topic" value="$(arg input_path_topic)" />
      <param name="output_path_topic" value="$(arg output_path_topic)" />
      <param name="error_topic" value="/road_vision/lateral_error" />
      <param name="status_topic" value="/road_vision/status" />
      <param name="invalid_decay_alpha" value="$(arg invalid_decay_alpha)" />
      <param name="max_shift_m" value="$(arg max_correction_m)" />
      <param name="filter_alpha" value="0.2" />
      <param name="invert_error" value="false" />
    </node>
  </group>
</launch>
