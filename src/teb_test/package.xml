<?xml version="1.0"?>
<package format="2">
  <name>teb_test</name>
  <version>0.0.1</version>
  <description>Outdoor TEB test package for the current Ackermann GPS/LIO stack.</description>

  <maintainer email="nuc@example.com">nuc</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>costmap_2d</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_core</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>tf2_ros</build_depend>

  <exec_depend>move_base</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_core</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>robot_base_driver</exec_depend>
  <exec_depend>osm_map_handler</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <nav_core plugin="${prefix}/plugins.xml" />
  </export>
</package>
