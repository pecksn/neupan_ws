<launch>
  <!-- Static sensor-only check: no base driver, cmd_vel, planner or goals. -->
  <include file="$(find robot_base_driver)/launch/g90_nmea.launch">
    <arg name="gps_time_mode" value="shadow" />
    <arg name="gps_time_clock_verified" value="false" />
    <arg name="use_gnss_time" value="false" />
  </include>
  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" />
  <include file="$(find fast_lio)/launch/mapping_mid360.launch">
    <arg name="rviz" value="false" />
    <arg name="pcd_save_en" value="false" />
  </include>
</launch>
