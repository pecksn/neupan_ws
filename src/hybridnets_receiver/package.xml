<?xml version="1.0"?>
<package format="2">
  <name>hybridnets_receiver</name>
  <version>0.1.0</version>
  <description>ROS1 receivers and diagnostics for remote HybridNets inference.</description>
  <maintainer email="nuc@example.com">lxw</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
