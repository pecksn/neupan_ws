[Unit]
Description=Shared ROS1 master only (Neupan container, no vehicle)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/docker start Neupan
ExecStart=/usr/bin/docker exec Neupan /bin/bash --noprofile --norc /home/nuc/lxw/neupan_ws/src/hybridnets_receiver/scripts/remote_video_service.sh master
ExecStop=/usr/bin/docker exec Neupan /bin/bash --noprofile --norc /home/nuc/lxw/neupan_ws/src/hybridnets_receiver/scripts/remote_video_service.sh stop-master
Restart=always
RestartSec=5
TimeoutStopSec=40
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
