<launch>
  <arg name="config"
       default="$(find hybridnets_receiver)/config/receiver.yaml" />

  <arg name="start_video" default="true" />
  <arg name="show_overlay" default="false" />
  <arg name="start_overlay" default="$(arg show_overlay)" />

  <arg name="virtual_video_device" default="/dev/video0" />
  <arg name="virtual_video_fps" default="30" />

  <!-- 接收 H.264/RTP，发布 ROS 图像并写入虚拟摄像头 -->
  <node if="$(arg start_video)"
        pkg="hybridnets_receiver"
        type="rtp_camera_receiver.py"
        name="rtp_camera_receiver"
        launch-prefix="/usr/bin/python3"
        output="screen">

    <rosparam command="load" file="$(arg config)" />

    <!-- 覆盖 YAML 中对应的配置 -->
    <param name="virtual_video_device"
           type="str" value="$(arg virtual_video_device)" />
    <param name="virtual_video_fps"
           type="int" value="$(arg virtual_video_fps)" />
  </node>

  <node pkg="hybridnets_receiver"
        type="hybridnets_json_receiver.py"
        name="hybridnets_json_receiver"
        output="screen">
    <rosparam command="load" file="$(arg config)" />
  </node>

  <!-- 仅在需要调试叠加图时处理完整分辨率图像 -->
  <node if="$(arg start_overlay)"
        pkg="hybridnets_receiver"
        type="hybridnets_overlay.py"
        name="hybridnets_overlay"
        output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="max_age" value="0.8" />
    <param name="debug_image_topic" value="/hybridnets/debug_image" />
  </node>

  <node if="$(arg show_overlay)"
        pkg="image_view"
        type="image_view"
        name="hybridnets_debug_view"
        output="screen">
    <remap from="image" to="/hybridnets/debug_image" />
  </node>
</launch>
