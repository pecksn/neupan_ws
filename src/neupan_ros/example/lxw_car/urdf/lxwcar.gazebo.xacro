<?xml version="1.0"?>
<robot name="lxwcar" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- 车轮物理属性（高摩擦力，防止打滑） -->
  <!-- ========================================== -->
  
  <gazebo reference="back_left_link">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="back_right_link">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_left_steer">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.01</minDepth>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="front_right_steer">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.01</minDepth>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <!-- ========================================== -->
  <!-- ros_control 插件（LIMO标准方案：控制转向关节） -->
  <!-- 插件发布转向命令，ros_control监听并执行 -->
  <!-- ========================================== -->
  
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

  <!-- ========================================== -->
  <!-- 阿克曼驱动插件（核心控制插件） -->
  <!-- ========================================== -->
  
  <gazebo>
    <plugin name="ackerman_drive_controller" filename="libgazebo_ros_ackerman.so">
      <updateRate>100.0</updateRate>
      <robotNamespace>/</robotNamespace>
      
      <!-- 四个车轮关节 -->
      <leftFrontJoint>front_left_wheel_joint</leftFrontJoint>
      <rightFrontJoint>front_right_wheel_joint</rightFrontJoint>
      <leftRearJoint>back_left_joint</leftRearJoint>
      <rightRearJoint>back_right_joint</rightRearJoint>
      
      <!-- 转向铰链关节（阿克曼核心） -->
      <leftHingeJoint>front_left_steer_joint</leftHingeJoint>
      <rightHingeJoint>front_right_steer_joint</rightHingeJoint>
      
      <!-- 车辆参数（根据R2实际尺寸） -->
      <wheelSeparation>0.1685</wheelSeparation>
      <wheelDiameter>0.066</wheelDiameter>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <maxSteerAngle>0.6</maxSteerAngle>
      
      <!-- ROS话题 -->
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      
      <!-- 控制参数 -->
      <torque>10</torque>
      <broadcastTF>true</broadcastTF>
      
      <!-- 里程计协方差 -->
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- ========================================== -->
  <!-- 激光雷达传感器插件 -->
  <!-- ========================================== -->
  
  <gazebo reference="laser_link">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>8</update_rate>
      <always_on>1</always_on>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-2.09439504</min_angle>
            <max_angle>2.09439504</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================================== -->
  <!-- 相机传感器插件 -->
  <!-- ========================================== -->
  
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================================== -->
  <!-- IMU 传感器插件（可选） -->
  <!-- ========================================== -->
  
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/imu_data</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>/imu/imu_data</topicName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>100.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

</robot>

