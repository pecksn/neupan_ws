<launch>
    <!-- ==================== 1. 全局运行模式配置 ==================== -->
    <arg name="outdoor_mode"        default="false" doc="true: 室外GPS地图 | false: 室内栅格地图"/>
    <!-- 开启此项提供高精度激光里程计 /Odometry -->
    <arg name="run_fast_lio_slam"   default="true"  doc="是否启动 FAST-LIO 激光里程计" />
    <arg name="use_amcl_indoor"     default="true" doc="在室内是否使用 AMCL 对齐 Map 与 Odom (依赖静态地图)" />
    
    <!-- 基础传感器配置 -->
    <arg name="enable_livox_driver" default="true"  doc="实车必须开启雷达驱动"/>
    <arg name="enable_rviz"         default="true" />
    <arg name="imu_topic"           default="/imu/data" />
    <arg name="indoor_map_file"     default="/home/nuc/lxw/maps/my_corridor_fastlio.yaml" />

    <!-- OSM 地图原点（建议与 datum 一致） -->
    <arg name="map_origin_lat" default="23.0398" />
    <arg name="map_origin_lon" default="113.39002" />
    <!-- 室外 GPS 固定基准点，防止每次启动原点漂移 -->
    <arg name="use_fixed_datum" default="true" doc="true: 使用固定datum对齐GPS与OSM原点" />
    <arg name="datum_yaw" default="0.0" />
    <arg name="navsat_delay" default="0.60" doc="navsat_transform 延迟处理时间(秒)，用于等待 odom->base_link TF 到位" />
    <arg name="navsat_transform_timeout" default="1.00" doc="navsat_transform TF 查询超时(秒)" />
    <arg name="outdoor_ekf_tf_time_offset" default="0.0" doc="室外时 EKF TF 时间偏移，建议 0 以避免时序警告" />
    <arg name="gps_port" default="/dev/wheeltec_gnss" doc="G90 接到上位机后的串口设备名" />
    <arg name="gps_baud" default="115200" doc="G90 NMEA 串口波特率" />
    <arg name="gps_frame" default="gps_link" doc="G90 在 TF 中使用的坐标系名称" />
    <arg name="gps_time_ref_source" default="gps" doc="TimeReference.source 字段" />
    <arg name="gps_use_rmc" default="false" doc="true 时使用 RMC，false 时使用 GGA/VTG" />
    <arg name="gps_rotation" default="90.0" doc="沿用 wheeltec_gps_driver 的航向旋转参数" />
    <arg name="gps_use_gnss_time" default="false" doc="是否使用 GNSS 自身时间戳" />
    <arg name="use_global_ekf" default="false" doc="false: 稳定模式直接使用/odometry/gps; true: 使用ekf_global" />
    <arg name="align_map_odom_with_global_local" default="true" doc="用 /odometry/global 与 /odometry/local 对齐 map->odom，便于点云与全局标记一致" />
    <arg name="map_odom_align_timeout" default="2.0" doc="map_odom 动态对齐消息接收超时(秒)" />
    <arg name="map_odom_align_yaw_bias_deg" default="-180.0" doc="map_odom 偏航补偿角(度); 若显示反向可设为 180" />
    <arg name="map_odom_align_use_global_yaw" default="true" doc="true: 用 /odometry/global 与 /odometry/local 的 yaw 实时对齐 map->odom" />

    <!-- 室外 OSM 规划参数 -->
    <arg name="osm_lookahead_dist" default="4.0" />
    <arg name="strict_road_mode" default="true" />
    <arg name="goal_snap_max_dist" default="50.0" />
    <arg name="start_snap_max_dist" default="50.0" />
    <arg name="outdoor_path_straight_spacing" default="2.5" doc="室外 OSM 路径直线段重采样间距(米)" />
    <arg name="outdoor_path_turn_spacing" default="0.8" doc="室外 OSM 路径转弯处重采样间距(米)" />
    <arg name="outdoor_path_turn_angle_deg_low" default="8.0" doc="低于该转角视作近似直线(度)" />
    <arg name="outdoor_path_turn_angle_deg_high" default="35.0" doc="高于该转角使用更密集采样(度)" />
    <arg name="outdoor_path_turn_dense_before" default="3.0" doc="入弯前额外加密长度(米)" />
    <arg name="outdoor_path_turn_dense_after" default="2.0" doc="出弯后保持加密的长度(米)" />
    <arg name="outdoor_path_turn_recover_after" default="6.0" doc="出弯后逐渐恢复为直线间距的长度(米)" />
    <arg name="outdoor_path_min_points" default="3" doc="室外路径最少下发给 NeuPAN 的点数" />
    <arg name="auto_set_initialpose" default="true" />
    <arg name="publish_pose_markers" default="true" />
    <arg name="publish_snap_debug_markers" default="true" />
    <arg name="gps_marker_timeout" default="2.0" />
    <arg name="enable_gps_goal_bridge" default="true" />
    <arg name="enable_yaw_monitor" default="true" />
    <arg name="outdoor_use_hybrid_astar" default="false" doc="室外是否启用 Hybrid A*；false 时 NeuPAN 直接跟踪 OSM A* 路径" />
    <arg name="outdoor_initial_path_topic" default="/osm_global_path" doc="室外 NeuPAN 初始路径来源话题；可选 /osm_global_path 或 /sPath" />
    <arg name="neupan_config_indoor" default="$(find neupan_ros)/example/lxw_car/config/neupan_config_indoor.yaml" />
    <arg name="neupan_config_outdoor" default="$(find neupan_ros)/example/lxw_car/config/neupan_config_outdoor.yaml" />
    <arg name="enable_adaptive_adjust" default="false" doc="是否根据最近障碍物距离动态调整 NeuPAN 权重" />
    <arg name="adaptive_far_distance" default="2.0" doc="超过该距离使用空旷模式权重" />
    <arg name="adaptive_near_distance" default="1.0" doc="小于该距离使用避障模式权重" />
    <arg name="adaptive_front_half_angle_deg" default="60.0" doc="只统计车头前方 +/- 该角度范围内的障碍点" />
    <arg name="clear_adjust_profile" default="1.2 21.0 0.05 0.3 0.2" doc="空旷模式 q_s p_u eta d_max d_min" />
    <arg name="avoid_adjust_profile" default="2.8 18.0 1.5 1.0 0.2" doc="避障模式 q_s p_u eta d_max d_min" />

    <!-- ==================== 2. 底盘驱动 & 状态估计 (EKF) ==================== -->
    <include file="$(find robot_base_driver)/launch/navigation_core.launch">
        <arg name="outdoor_mode" value="$(arg outdoor_mode)" />
        <arg name="imu_topic"    value="$(arg imu_topic)" />
        <arg name="use_fixed_datum" value="$(arg use_fixed_datum)" />
        <arg name="datum_lat" value="$(arg map_origin_lat)" />
        <arg name="datum_lon" value="$(arg map_origin_lon)" />
        <arg name="datum_yaw" value="$(arg datum_yaw)" />
        <arg name="navsat_delay" value="$(arg navsat_delay)" />
        <arg name="navsat_transform_timeout" value="$(arg navsat_transform_timeout)" />
        <arg name="outdoor_ekf_tf_time_offset" value="$(arg outdoor_ekf_tf_time_offset)" />
        <arg name="gps_port" value="$(arg gps_port)" />
        <arg name="gps_baud" value="$(arg gps_baud)" />
        <arg name="gps_frame" value="$(arg gps_frame)" />
        <arg name="gps_time_ref_source" value="$(arg gps_time_ref_source)" />
        <arg name="gps_use_rmc" value="$(arg gps_use_rmc)" />
        <arg name="gps_rotation" value="$(arg gps_rotation)" />
        <arg name="gps_use_gnss_time" value="$(arg gps_use_gnss_time)" />
        <arg name="use_global_ekf" value="$(arg use_global_ekf)" />
        <arg name="publish_static_map_odom_outdoor" value="false" if="$(arg align_map_odom_with_global_local)" />
        <arg name="publish_static_map_odom_outdoor" value="true" unless="$(arg align_map_odom_with_global_local)" />
        <!-- 本launch内部自行管理 amcl/static_map_odom，防止和底层冲突 -->
        <arg name="publish_static_map_odom" value="false" />
    </include>

    <group if="$(arg outdoor_mode)">
        <group if="$(arg align_map_odom_with_global_local)">
            <group unless="$(arg use_global_ekf)">
                <node pkg="robot_base_driver" type="map_odom_align_bridge.py" name="map_odom_align_bridge" output="screen">
                    <param name="global_topic" value="/odometry/global"/>
                    <param name="local_topic" value="/odometry/local"/>
                    <param name="parent_frame" value="map"/>
                    <param name="child_frame" value="odom"/>
                    <param name="timeout_sec" value="$(arg map_odom_align_timeout)"/>
                    <param name="yaw_bias_deg" value="$(arg map_odom_align_yaw_bias_deg)"/>
                    <param name="align_yaw_with_global" value="$(arg map_odom_align_use_global_yaw)"/>
                </node>
            </group>
        </group>
    </group>

    <!-- ==================== 3. 激光雷达 & 3D转2D处理 ==================== -->
    <!-- 3.1 启动 Livox MID360 -->
    <group if="$(arg enable_livox_driver)">
        <include file="$(find livox_ros_driver2)/launch_ROS1/rviz_MID360.launch">
            <arg name="rviz_enable"  value="false"/>
            <arg name="msg_frame_id" value="livox_frame"/>
            <!-- 需提供 CustomMsg 给 FAST-LIO -->
            <arg name="xfer_format"  value="1"/>
        </include>
    </group>

    <!-- 3.2 雷达机械安装外参 (请根据实车尺寸调整位置) -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_livox" args="0.1 0 0.25 0 0 0 base_link livox_frame 100"/>
    <node pkg="tf" type="static_transform_publisher" name="base_to_body" args="0.1 0 0.25 0 0 0 base_link body 100"/>
    <!-- GPS 天线外参，供 navsat_transform 去除 GPS 与车体原点偏移 -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_gps" args="0.0 0.0 0.25 0 0 0 base_link gps_link 100"/>
    <node pkg="tf" type="static_transform_publisher" name="odom_to_camera_init" args="0 0 0 0 0 0 odom camera_init 100"/>

    <!-- 3.3 FAST-LIO / 高精度里程计 -->
    <group if="$(arg run_fast_lio_slam)">
        <include file="$(find fast_lio)/launch/mapping_mid360.launch">
            <arg name="rviz" value="false" /> 
        </include>
    </group>

    <!-- 3.4 3D点云截取为2D (给局部避障和可能的AMCL定位用) -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan" output="screen">
        <!-- 读取 FAST-LIO 去畸变后的点云 -->
        <remap from="cloud_in" to="/cloud_registered_body"/>
        <remap from="scan"     to="/scan"/>
        <param name="target_frame" value="base_link"/>
        <param name="transform_tolerance" value="0.01"/>
        <param name="min_height"   value="0.2"/>
        <param name="max_height"   value="0.8"/>
        <param name="angle_min"    value="-3.14159"/>
        <param name="angle_max"    value="3.14159"/>
        <param name="angle_increment" value="0.0087"/>
        <param name="scan_time" value="0.1"/>
        <param name="range_max"    value="30.0"/>
        <param name="range_min"    value="0.4"/>
        <param name="use_inf"      value="true"/>
    </node>

    <!-- 仅用于RViz显示：将点云投影到 map 坐标，便于和室外全局标记对齐观察 -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan_viz" output="screen">
        <remap from="cloud_in" to="/cloud_registered_body"/>
        <remap from="scan"     to="/scan_viz"/>
        <param name="target_frame" value="map"/>
        <param name="transform_tolerance" value="0.25"/>
        <param name="min_height"   value="0.2"/>
        <param name="max_height"   value="0.8"/>
        <param name="angle_min"    value="-3.14159"/>
        <param name="angle_max"    value="3.14159"/>
        <param name="angle_increment" value="0.0087"/>
        <param name="scan_time" value="0.1"/>
        <param name="range_max"    value="30.0"/>
        <param name="range_min"    value="0.4"/>
        <param name="use_inf"      value="true"/>
    </node>

    <!-- ==================== 4. 环境地图 & 全局定位 ==================== -->
    <group unless="$(arg outdoor_mode)">
        <node name="map_server" pkg="map_server" type="map_server" args="$(arg indoor_map_file)" output="screen" />
        
        <group if="$(arg use_amcl_indoor)">
            <node pkg="amcl" type="amcl" name="amcl" output="screen">
                <remap from="scan" to="/scan"/>
                <param name="odom_frame_id" value="odom"/>
                <param name="base_frame_id" value="base_link"/>
                <param name="global_frame_id" value="map"/>
            </node>
        </group>
        <group unless="$(arg use_amcl_indoor)">
            <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom 100" />
        </group>
    </group>

    <group if="$(arg outdoor_mode)">
        <!-- 启动 OSM 大地图拼接节点 -->
        <node pkg="osm_map_handler" type="static_osm_map_server.py" name="osm_road_map" output="screen">
            <param name="map_dir" value="/home/nuc/lxw/ros_maps/19" />
            <param name="default_lat" value="$(arg map_origin_lat)" /> 
            <param name="default_lon" value="$(arg map_origin_lon)" />
        </node>
        
        <!-- 启动室外 C++ A* 规划器 -->
        <node pkg="osm_map_handler" type="global_astar_node" name="outdoor_global_astar" output="screen">
            <param name="default_lat" value="$(arg map_origin_lat)" />
            <param name="default_lon" value="$(arg map_origin_lon)" />
            <param name="lookahead_dist" value="$(arg osm_lookahead_dist)" />
            <param name="strict_road_mode" value="$(arg strict_road_mode)" />
            <param name="goal_snap_max_dist" value="$(arg goal_snap_max_dist)" />
            <param name="start_snap_max_dist" value="$(arg start_snap_max_dist)" />
            <param name="path_straight_spacing" value="$(arg outdoor_path_straight_spacing)" />
            <param name="path_turn_spacing" value="$(arg outdoor_path_turn_spacing)" />
            <param name="path_turn_angle_deg_low" value="$(arg outdoor_path_turn_angle_deg_low)" />
            <param name="path_turn_angle_deg_high" value="$(arg outdoor_path_turn_angle_deg_high)" />
            <param name="path_turn_dense_before" value="$(arg outdoor_path_turn_dense_before)" />
            <param name="path_turn_dense_after" value="$(arg outdoor_path_turn_dense_after)" />
            <param name="path_turn_recover_after" value="$(arg outdoor_path_turn_recover_after)" />
            <param name="path_min_points" value="$(arg outdoor_path_min_points)" />
            <param name="auto_set_initialpose" value="$(arg auto_set_initialpose)" />
            <param name="publish_pose_markers" value="$(arg publish_pose_markers)" />
            <param name="publish_snap_debug_markers" value="$(arg publish_snap_debug_markers)" />
            <param name="gps_marker_timeout" value="$(arg gps_marker_timeout)" />
        </node>

        <!-- 经由经纬度输入目标点：/gps_goal_ll -> /move_base_simple/goal -->
        <node if="$(arg enable_gps_goal_bridge)" pkg="osm_map_handler" type="gps_goal_bridge.py" name="gps_goal_bridge" output="screen">
            <param name="default_lat" value="$(arg map_origin_lat)" />
            <param name="default_lon" value="$(arg map_origin_lon)" />
            <param name="input_topic" value="/gps_goal_ll" />
            <param name="output_topic" value="/move_base_simple/goal" />
        </node>
    </group>

    <group if="$(arg enable_yaw_monitor)">
        <node pkg="robot_base_driver" type="yaw_compare_monitor.py" name="yaw_compare_monitor" output="screen">
            <param name="odom_topic" value="/odometry/global" />
            <param name="heading_topic" value="/heading" />
            <param name="label" value="odom_vs_g90_full" />
            <param name="log_to_file" value="true" />
            <param name="log_dir" value="/home/nuc/lxw/neupan_ws/tracker_logs" />
        </node>
    </group>

    <!-- ==================== 5. 导航规划体系 ==================== -->
    <!-- 室内：始终使用 Hybrid A*，NeuPAN 监听 /sPath -->
    <group unless="$(arg outdoor_mode)">
        <node name="hybrid_astar" pkg="hybrid_astar" type="hybrid_astar" output="screen">
            <remap from="/map" to="/map" />
            <remap from="/move_base_simple/goal" to="/move_base_simple/goal" />
        </node>
        <node pkg="tf" type="static_transform_publisher" name="map_to_path" args="0 0 0 0 0 0 map path 100" />

        <node pkg="neupan_ros" type="neupan_node.py" name="neupan_control" output="screen">
            <param name="config_file" value="$(arg neupan_config_indoor)"/>
            <param name="map_frame"   value="map"/>
            <param name="base_frame"  value="base_link"/>
            <param name="lidar_frame" value="base_link"/>
            <param name="scan_downsample" value="1"/>
            <param name="scan_range" value="0.1 20.0"/>
            <param name="scan_angle_range" value="-3.14 3.14"/>
            <param name="marker_size" value="0.05"/>
            <param name="marker_z" value="0.3"/>
            <param name="dune_checkpoint" value="$(find neupan_ros)/example/lxw_car/model/acker_robot_default_2/model_5000.pth"/>
            <param name="refresh_initial_path" value="true"/>
            <param name="include_initial_path_direction" value="true"/>
            <param name="enable_adaptive_adjust" value="$(arg enable_adaptive_adjust)"/>
            <param name="adaptive_far_distance" value="$(arg adaptive_far_distance)"/>
            <param name="adaptive_near_distance" value="$(arg adaptive_near_distance)"/>
            <param name="adaptive_front_half_angle_deg" value="$(arg adaptive_front_half_angle_deg)"/>
            <param name="clear_adjust_profile" value="$(arg clear_adjust_profile)"/>
            <param name="avoid_adjust_profile" value="$(arg avoid_adjust_profile)"/>
            <remap from="/initial_path" to="/sPath" />
            <!-- <remap from="/neupan_goal"  to="/move_base_simple/goal"/> -->
        </node>
    </group>

    <!-- 室外：默认只用 OSM A*，可选启用 Hybrid A* -->
    <group if="$(arg outdoor_mode)">
        <group if="$(arg outdoor_use_hybrid_astar)">
            <node name="hybrid_astar" pkg="hybrid_astar" type="hybrid_astar" output="screen">
                <remap from="/map" to="/map" />
                <remap from="/move_base_simple/goal" to="/hybrid_astar_subgoal" />
            </node>
            <node pkg="tf" type="static_transform_publisher" name="map_to_path_outdoor" args="0 0 0 0 0 0 map path 100" />

            <node pkg="neupan_ros" type="neupan_node.py" name="neupan_control" output="screen">
                <param name="config_file" value="$(arg neupan_config_outdoor)"/>
                <param name="map_frame"   value="map"/>
                <param name="base_frame"  value="base_link"/>
                <param name="lidar_frame" value="base_link"/>
                <param name="scan_downsample" value="1"/>
                <param name="scan_range" value="0.1 20.0"/>
                <param name="scan_angle_range" value="-3.14 3.14"/>
                <param name="marker_size" value="0.05"/>
                <param name="marker_z" value="0.3"/>
                <param name="dune_checkpoint" value="$(find neupan_ros)/example/lxw_car/model/acker_robot_default_2/model_5000.pth"/>
                <param name="refresh_initial_path" value="true"/>
                <param name="include_initial_path_direction" value="true"/>
                <param name="enable_adaptive_adjust" value="$(arg enable_adaptive_adjust)"/>
                <param name="adaptive_far_distance" value="$(arg adaptive_far_distance)"/>
                <param name="adaptive_near_distance" value="$(arg adaptive_near_distance)"/>
                <param name="adaptive_front_half_angle_deg" value="$(arg adaptive_front_half_angle_deg)"/>
                <param name="clear_adjust_profile" value="$(arg clear_adjust_profile)"/>
                <param name="avoid_adjust_profile" value="$(arg avoid_adjust_profile)"/>
                <remap from="/initial_path" to="$(arg outdoor_initial_path_topic)" />
                <!-- <remap from="/neupan_goal"  to="/move_base_simple/goal"/> -->
            </node>
        </group>

        <group unless="$(arg outdoor_use_hybrid_astar)">
            <node pkg="neupan_ros" type="neupan_node.py" name="neupan_control" output="screen">
                <param name="config_file" value="$(arg neupan_config_outdoor)"/>
                <param name="map_frame"   value="map"/>
                <param name="base_frame"  value="base_link"/>
                <param name="lidar_frame" value="base_link"/>
                <param name="scan_downsample" value="1"/>
                <param name="scan_range" value="0.1 20.0"/>
                <param name="scan_angle_range" value="-3.14 3.14"/>
                <param name="marker_size" value="0.05"/>
                <param name="marker_z" value="0.3"/>
                <param name="dune_checkpoint" value="$(find neupan_ros)/example/lxw_car/model/acker_robot_default_2/model_5000.pth"/>
                <param name="refresh_initial_path" value="true"/>
                <param name="include_initial_path_direction" value="true"/>
                <param name="enable_adaptive_adjust" value="$(arg enable_adaptive_adjust)"/>
                <param name="adaptive_far_distance" value="$(arg adaptive_far_distance)"/>
                <param name="adaptive_near_distance" value="$(arg adaptive_near_distance)"/>
                <param name="adaptive_front_half_angle_deg" value="$(arg adaptive_front_half_angle_deg)"/>
                <param name="clear_adjust_profile" value="$(arg clear_adjust_profile)"/>
                <param name="avoid_adjust_profile" value="$(arg avoid_adjust_profile)"/>
                <remap from="/initial_path" to="$(arg outdoor_initial_path_topic)" />
                <!-- <remap from="/neupan_goal"  to="/move_base_simple/goal"/> -->
            </node>
        </group>
    </group>

    <!-- ==================== 6. 数据可视化 ==================== -->
    <group if="$(arg enable_rviz)">
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find hybrid_astar)/launch/config.rviz" />
    </group>
</launch>
