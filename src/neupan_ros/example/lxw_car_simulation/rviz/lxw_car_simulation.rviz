Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: odom
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Color: 255; 80; 80
      Enabled: true
      Name: Scan
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Topic: /scan
    - Class: rviz/Path
      Color: 25; 180; 80
      Enabled: true
      Name: NeuPAN Initial Path
      Topic: /neupan_initial_path
    - Class: rviz/Path
      Color: 40; 120; 255
      Enabled: true
      Name: NeuPAN Plan
      Topic: /neupan_plan
    - Class: rviz/Marker
      Enabled: true
      Name: Robot Marker
      Topic: /robot_marker
    - Class: rviz/MarkerArray
      Enabled: true
      Name: DUNE Points
      Topic: /dune_point_markers
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Pitch: 0.785
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1400
