Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 40; 45
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz/RobotModel
      Name: Simulated Car
      Enabled: true
      Robot Description: /outdoor_sim/robot_description
    - Class: rviz/LaserScan
      Name: Simulated LiDAR
      Enabled: true
      Topic: /outdoor_sim/scan
      Size (m): 0.04
    - Class: rviz/Path
      Name: OSM Road Route
      Enabled: true
      Topic: /outdoor_sim/osm_global_path
      Color: 40; 140; 255
    - Class: rviz/Path
      Name: Accepted Reference With Turn
      Enabled: true
      Topic: /outdoor_sim/neupan_initial_path
      Color: 80; 230; 100
    - Class: rviz/Path
      Name: NeuPAN Local Plan
      Enabled: true
      Topic: /outdoor_sim/neupan_plan
      Color: 255; 140; 180
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetGoal
      Topic: /outdoor_sim/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 28
      Focal Point: {X: 7, Y: 0, Z: 0}
      Pitch: 1.2
      Yaw: 0
Window Geometry:
  Width: 1280
  Height: 800
