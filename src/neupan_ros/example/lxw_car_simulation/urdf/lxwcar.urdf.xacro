<?xml version="1.0" encoding="utf-8"?>
<robot name="lxwcar" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Parameters aligned with example/lxw_car/config/neupan_config_outdoor.yaml
       and robot_base_driver/launch/navigation_core.launch. -->
  <xacro:property name="body_length" value="0.95"/>
  <xacro:property name="body_width" value="0.75"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="body_mass" value="45.0"/>
  <xacro:property name="wheelbase" value="0.67"/>
  <xacro:property name="track_width" value="0.52"/>
  <xacro:property name="wheel_radius" value="0.1275"/>
  <xacro:property name="wheel_diameter" value="${2.0 * wheel_radius}"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <xacro:property name="max_steer_angle" value="0.35"/>

  <xacro:property name="front_axle_x" value="${wheelbase / 2.0}"/>
  <xacro:property name="rear_axle_x" value="${-wheelbase / 2.0}"/>
  <xacro:property name="left_wheel_y" value="${track_width / 2.0}"/>
  <xacro:property name="right_wheel_y" value="${-track_width / 2.0}"/>
  <xacro:arg name="cad_visual" default="true"/>

  <xacro:include filename="lxwcar.gazebo.xacro"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia
        ixx="${body_mass * (body_width * body_width + body_height * body_height) / 12.0}"
        ixy="0"
        ixz="0"
        iyy="${body_mass * (body_length * body_length + body_height * body_height) / 12.0}"
        iyz="0"
        izz="${body_mass * (body_length * body_length + body_width * body_width) / 12.0}"/>
    </inertial>
    <xacro:if value="$(arg cad_visual)">
      <visual>
        <!-- STEP uses millimetres. The exported mesh bottom is 118.6 mm below CAD origin. -->
        <origin xyz="-0.0035 0 0.1186" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://neupan_ros/example/lxw_car_simulation/meshes/lxwcar_cad.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="lxw_cad_grey">
          <color rgba="0.55 0.58 0.60 1"/>
        </material>
      </visual>
    </xacro:if>
    <xacro:unless value="$(arg cad_visual)">
    <visual>
      <origin xyz="0 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="lxw_body_grey">
        <color rgba="0.55 0.58 0.60 1"/>
      </material>
    </visual>
    </xacro:unless>
    <collision>
      <origin xyz="0 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.018" iyz="0" izz="0.010"/>
      </inertial>
      <xacro:unless value="$(arg cad_visual)">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="lxw_wheel_black">
          <color rgba="0.02 0.02 0.02 1"/>
        </material>
      </visual>
      </xacro:unless>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="steer_link" params="name">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <xacro:unless value="$(arg cad_visual)">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.06 0.06"/>
        </geometry>
        <material name="lxw_steer_grey">
          <color rgba="0.35 0.35 0.35 1"/>
        </material>
      </visual>
      </xacro:unless>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.06 0.06"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:wheel_link name="back_left_link"/>
  <joint name="back_left_joint" type="continuous">
    <origin xyz="${rear_axle_x} ${left_wheel_y} ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_left_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel_link name="back_right_link"/>
  <joint name="back_right_joint" type="continuous">
    <origin xyz="${rear_axle_x} ${right_wheel_y} ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_right_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:steer_link name="front_left_steer"/>
  <joint name="front_left_steer_joint" type="revolute">
    <origin xyz="${front_axle_x} ${left_wheel_y} ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_steer"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steer_angle}" upper="${max_steer_angle}" effort="60" velocity="0.35"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <xacro:wheel_link name="front_left_wheel"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_left_steer"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:steer_link name="front_right_steer"/>
  <joint name="front_right_steer_joint" type="revolute">
    <origin xyz="${front_axle_x} ${right_wheel_y} ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_steer"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steer_angle}" upper="${max_steer_angle}" effort="60" velocity="0.35"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <xacro:wheel_link name="front_right_wheel"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_right_steer"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="livox_frame">
    <xacro:unless value="$(arg cad_visual)">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
      <material name="lxw_lidar_blue">
        <color rgba="0.08 0.20 0.75 1"/>
      </material>
    </visual>
    </xacro:unless>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_livox" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="0.1 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="laser_link"/>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- Simulated 2D scan slice. Lifted slightly above the body so Gazebo rays do
         not immediately hit the car itself. -->
    <origin xyz="0.1 0 0.38" rpy="0 0 0"/>
  </joint>

  <link name="body"/>
  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child link="body"/>
    <origin xyz="0.1 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="base_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.1 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="gps_link"/>
  <joint name="base_to_gps" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <transmission name="front_left_steer_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_steer_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_steer_joint_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="front_right_steer_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_steer_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_steer_joint_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
</robot>
