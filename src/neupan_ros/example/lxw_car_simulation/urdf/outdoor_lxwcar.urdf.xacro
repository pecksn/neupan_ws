<?xml version="1.0"?>
<robot name="outdoor_lxwcar" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Rear axle is x=0, exactly matching NeuPAN's 0.95 x 0.85 m footprint. -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.20"/></joint>
  <link name="base_link">
    <inertial><origin xyz="0.335 0 0.08"/><mass value="45"/><inertia ixx="3" ixy="0" ixz="0" iyy="4" iyz="0" izz="5"/></inertial>
    <visual><origin xyz="0.3315 0 -0.0814"/><geometry><mesh filename="package://neupan_ros/example/lxw_car_simulation/meshes/lxwcar_cad.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0.335 0 0.08"/><geometry><box size="0.95 0.85 0.22"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="name parent xyz">
    <link name="${name}"><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1275" length="0.08"/></geometry></collision></link>
    <joint name="${name}_joint" type="continuous"><parent link="${parent}"/><child link="${name}"/><origin xyz="${xyz}"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel name="back_left" parent="base_link" xyz="0 0.335 -0.0725"/>
  <xacro:wheel name="back_right" parent="base_link" xyz="0 -0.335 -0.0725"/>
  <xacro:macro name="front" params="side y">
    <link name="front_${side}_steer"><inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
    <joint name="front_${side}_steer_joint" type="revolute"><parent link="base_link"/><child link="front_${side}_steer"/><origin xyz="0.67 ${y} -0.0725"/><axis xyz="0 0 1"/><limit lower="-0.35" upper="0.35" effort="60" velocity="1"/></joint>
    <xacro:wheel name="front_${side}_wheel" parent="front_${side}_steer" xyz="0 0 0"/>
  </xacro:macro>
  <xacro:front side="left" y="0.335"/><xacro:front side="right" y="-0.335"/>
  <link name="livox_frame"/><joint name="livox_joint" type="fixed"><parent link="base_link"/><child link="livox_frame"/><origin xyz="0.1 0 0.35"/></joint>
  <link name="laser_link"/><joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0.1 0 0.50"/></joint>
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="laser_link"><sensor name="outdoor_ray" type="ray"><always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
    <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.1</min><max>30</max><resolution>0.01</resolution></range></ray>
    <plugin name="outdoor_ros_laser" filename="libgazebo_ros_laser.so"><topicName>/outdoor_sim/scan_raw</topicName><frameName>laser_link</frameName></plugin>
  </sensor></gazebo>
</robot>
