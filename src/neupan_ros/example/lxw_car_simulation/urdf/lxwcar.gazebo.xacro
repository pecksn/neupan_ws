<?xml version="1.0"?>
<robot name="lxwcar" xmlns:xacro="http://ros.org/wiki/xacro">
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="back_left_link">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="back_right_link">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>10000000.0</kp>
    <kd>1</kd>
    <minDepth>0.01</minDepth>
    <fdir1>1 0 0</fdir1>
    <maxContacts>64</maxContacts>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_left_steer">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="front_right_steer">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="livox_frame">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>/livox/imu</topicName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>100.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <frameName>imu_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
