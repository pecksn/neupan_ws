<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lxw_car_obstacles">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <include>
      <name>box_obstacle_1</name>
      <uri>model://lxw_box_obstacle</uri>
      <pose>3.0 0.9 0 0 0 0.25</pose>
    </include>

    <include>
      <name>box_obstacle_2</name>
      <uri>model://lxw_box_obstacle</uri>
      <pose>5.0 -0.8 0 0 0 -0.15</pose>
    </include>

    <include>
      <name>cylinder_obstacle_1</name>
      <uri>model://lxw_cylinder_obstacle</uri>
      <pose>2.1 -1.1 0 0 0 0</pose>
    </include>

    <include>
      <name>cylinder_obstacle_2</name>
      <uri>model://lxw_cylinder_obstacle</uri>
      <pose>4.2 1.2 0 0 0 0</pose>
    </include>
  </world>
</sdf>
