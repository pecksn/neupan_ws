<launch>
    <arg name="world_name" default="$(find neupan_ros)/example/lxw_car_simulation/worlds/lxw_car_obstacles.world"/>
    <arg name="paused" default="false"/>
    <arg name="gui" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="use_sim_time" default="true"/>

    <arg name="x" default="0.0"/>
    <arg name="y" default="0.0"/>
    <arg name="z" default="0.0"/>
    <arg name="yaw" default="0.0"/>

    <arg name="config_file" default="$(find neupan_ros)/example/lxw_car_simulation/config/neupan_config_sim.yaml"/>
    <arg name="dune_checkpoint" default="$(find neupan_ros)/example/lxw_car/model/acker_robot_default_2/model_5000.pth"/>
    <arg name="refresh_initial_path" default="true"/>
    <arg name="rviz_config" default="$(find neupan_ros)/example/lxw_car_simulation/rviz/lxw_car_simulation.rviz"/>
    <arg name="cad_visual" default="true"/>
    <arg name="start_neupan" default="true"/>
    <arg name="command_topic" default="/neupan_cmd_vel"/>
    <arg name="model_states_topic" default="/gazebo/model_states"/>
    <arg name="model_state_command_topic" default=""/>
    <arg name="scan_topic" default="/scan"/>
    <!-- The ray slice is above the car. A rear-axle-centred box would discard
         real close returns; comparison uses its shared body-centred filter. -->
    <arg name="scan_self_filter" default="false"/>
    <arg name="neupan_goal_topic" default="/move_base_simple/goal"/>
    <arg name="publish_demo_goal" default="false"/>
    <arg name="dynamic_obstacles" default="false"/>
    <arg name="obstacle_max_speed" default="0.5"/>
    <arg name="show_goal_marker" default="true"/>
    <arg name="cmd_timeout" default="0.5"/>
    <arg name="rvo_goal_x_min" default="1.5"/>
    <arg name="rvo_goal_x_max" default="9.0"/>
    <arg name="rvo_goal_y_min" default="-4.0"/>
    <arg name="rvo_goal_y_max" default="4.0"/>
    <arg name="enable_adaptive_adjust" default="true"/>
    <arg name="adaptive_far_distance" default="2.0"/>
    <arg name="adaptive_near_distance" default="1.0"/>
    <arg name="adaptive_front_half_angle_deg" default="60.0"/>
    <arg name="clear_adjust_profile" default="1.2 21.0 0.05 0.3 0.2"/>
    <arg name="avoid_adjust_profile" default="2.8 18.0 1.5 1.0 0.2"/>

    <param name="/use_sim_time" value="$(arg use_sim_time)"/>
    <env name="GAZEBO_MODEL_PATH" value="$(find neupan_ros)/example/lxw_car_simulation/models:$(optenv GAZEBO_MODEL_PATH)"/>
    <env name="GAZEBO_PLUGIN_PATH" value="$(find neupan_ros)/../../devel/lib:$(optenv GAZEBO_PLUGIN_PATH)"/>

    <group if="$(arg dynamic_obstacles)">
        <rosparam command="load" file="$(find neupan_ros)/example/lxw_car_simulation/config/rvo_config_complex.yaml"/>
        <param name="maxSpeed" value="$(arg obstacle_max_speed)"/>

        <node name="rvo_node" pkg="rvo_ros" type="rvo_node" output="screen">
            <remap from="/rvo/model_states" to="/gazebo/model_states"/>
            <remap from="/rvo_vel" to="/obstacles_velocity"/>
        </node>

        <node name="rvo_set_goals" pkg="rvo_ros" type="set_goals_client"
              args="random $(arg rvo_goal_x_min) $(arg rvo_goal_x_max) $(arg rvo_goal_y_min) $(arg rvo_goal_y_max)"
              output="screen"/>
    </group>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>

    <param name="robot_description"
           command="$(find xacro)/xacro $(find neupan_ros)/example/lxw_car_simulation/urdf/lxwcar.urdf.xacro cad_visual:=$(arg cad_visual) scan_topic:=$(arg scan_topic)"/>

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_lxwcar" output="screen"
          args="-urdf -param robot_description -model lxwcar -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)"/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
        <param name="publish_frequency" value="50.0"/>
    </node>

    <node if="$(arg show_goal_marker)" pkg="neupan_ros" type="gazebo_goal_marker.py"
          name="gazebo_goal_marker" output="screen"/>

    <node pkg="neupan_ros" type="ackermann_sim_driver.py"
          name="ackermann_sim_driver" output="screen">
        <param name="model_name" value="lxwcar"/>
        <param name="model_states_topic" value="$(arg model_states_topic)"/>
        <param name="model_state_command_topic" value="$(arg model_state_command_topic)"/>
        <param name="cmd_topic" value="$(arg command_topic)"/>
        <param name="odom_frame" value="odom"/>
        <param name="base_frame" value="base_footprint"/>
        <param name="wheelbase" value="0.67"/>
        <param name="wheel_radius" value="0.1275"/>
        <param name="max_speed" value="1.5"/>
        <param name="max_steer" value="0.35"/>
        <param name="cmd_timeout" value="$(arg cmd_timeout)"/>
        <param name="x" value="$(arg x)"/>
        <param name="y" value="$(arg y)"/>
        <param name="yaw" value="$(arg yaw)"/>
        <param name="model_z" value="$(arg z)"/>
    </node>

    <node if="$(arg start_neupan)" pkg="neupan_ros" type="neupan_node.py" name="neupan_control" output="screen">
        <param name="config_file" value="$(arg config_file)"/>
        <param name="map_frame" value="odom"/>
        <param name="base_frame" value="base_footprint"/>
        <param name="lidar_frame" value="laser_link"/>
        <param name="scan_downsample" value="1"/>
        <param name="scan_range" value="0.1 20.0"/>
        <param name="scan_angle_range" value="-3.14 3.14"/>
        <param name="scan_self_filter" value="$(arg scan_self_filter)"/>
        <param name="scan_self_filter_length" value="0.95"/>
        <param name="scan_self_filter_width" value="0.75"/>
        <param name="scan_self_filter_margin" value="0.05"/>
        <param name="marker_size" value="0.05"/>
        <param name="marker_z" value="0.3"/>
        <param name="dune_checkpoint" value="$(arg dune_checkpoint)"/>
        <param name="refresh_initial_path" value="$(arg refresh_initial_path)"/>
        <param name="enable_adaptive_adjust" value="$(arg enable_adaptive_adjust)"/>
        <param name="adaptive_far_distance" value="$(arg adaptive_far_distance)"/>
        <param name="adaptive_near_distance" value="$(arg adaptive_near_distance)"/>
        <param name="adaptive_front_half_angle_deg" value="$(arg adaptive_front_half_angle_deg)"/>
        <param name="clear_adjust_profile" value="$(arg clear_adjust_profile)"/>
        <param name="avoid_adjust_profile" value="$(arg avoid_adjust_profile)"/>
        <param name="stop_on_scan_fault" value="true"/>
        <param name="scan_timeout" value="0.5"/>
        <param name="scan_transform_timeout" value="0.5"/>
        <remap from="/neupan_goal" to="$(arg neupan_goal_topic)"/>
    </node>

    <node if="$(arg publish_demo_goal)" pkg="neupan_ros" type="publish_demo_goal.py"
          name="lxw_car_simulation_demo_goal" output="screen">
        <param name="x" value="6.0"/>
        <param name="y" value="0.0"/>
        <param name="yaw" value="0.0"/>
        <param name="delay" value="3.0"/>
    </node>

    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
          args="-d $(arg rviz_config)" output="screen"/>
</launch>
