<launch>
    <!-- ========================================================= -->
    <!-- 核心参数切换：室内模式(false) / 室外模式(true)            -->
    <!-- 默认设为 false (室内走廊测试)，室外时运行时加 outdoor_mode:=true -->
    <!-- ========================================================= -->
    <arg name="outdoor_mode" default="false" />
    
    <!-- ========================================================= -->
    <!-- 1. 启动底层与定位融合 (包含底盘串口、EKF、GPS等)              -->
    <!-- ========================================================= -->
    <include file="$(find robot_base_driver)/launch/navigation_core.launch">
        <arg name="outdoor_mode" value="$(arg outdoor_mode)" />
    </include>

    <!-- ========================================================= -->
    <!-- 2. 地图服务配置                                           -->
    <!-- ========================================================= -->
    <!-- 室内模式：加载现有的静态 pgm/yaml 栅格地图 -->
    <group unless="$(arg outdoor_mode)">
        <node name="map_server" pkg="map_server" type="map_server" args="$(env HOME)/lxw/maps/my_indoor_map.yaml" output="screen" />
    </group>
    
    <!-- 室外模式：需要依靠 OSMmap 在地图上局部动态渲染代价地图 -->
    <group if="$(arg outdoor_mode)">
        <!-- 你可以之后在这里接入 OSMmap 的显示地图节点 -->
        <!-- <include file="$(find OSMmap)/launch/show_map.launch" /> -->
    </group>

    <!-- ========================================================= -->
    <!-- 3. 全局规划器：Hybrid A* (混合A星)                          -->
    <!-- ========================================================= -->
    <node name="hybrid_astar" pkg="hybrid_astar" type="hybrid_astar" output="screen" />
    <!-- 启动混合A*需要的配套TF发布节点 -->
    <node name="tf_broadcaster_ha" pkg="hybrid_astar" type="tf_broadcaster" />

    <!-- ========================================================= -->
    <!-- 4. 局部规划与动态避障：NeuPAN                               -->
    <!-- ========================================================= -->
    <node pkg="neupan_ros" type="neupan_node.py" name="neupan_node" output="screen">
        <!-- 接收全局平滑路径作为初始输入 -->
        <remap from="/initial_path" to="/sPath" /> 
        
        <!-- 输出指令已经通过我们刚才修改的 /neupan_cmd_vel 给到底盘驱动 -->
        
        <!-- 【注意】如果NeuPAN报错说收不到 /scan，你需要加一个点云转scan的节点 -->
        <!-- <remap from="/scan" to="/your_lidar_scan_topic" /> -->
    </node>

    <!-- ========================================================= -->
    <!-- 5. 可视化 RViz                                            -->
    <!-- ========================================================= -->
    <!-- 使用混合 A* 提供的现成视图配置，包含地图、轨迹、车体框等 -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find hybrid_astar)/launch/config.rviz" />

</launch>
