<launch>
  <arg name="device" default="/dev/video0" />
  <arg name="width" default="1920" />
  <arg name="height" default="1080" />
  <arg name="fps" default="30" />
  <arg name="preview" default="false" />

  <node pkg="usb_cam" type="usb_cam_node" name="camera" output="screen">
    <rosparam command="load" file="$(find usb_camera)/config/camera.yaml" />
    <param name="video_device" value="$(arg device)" />
    <param name="image_width" value="$(arg width)" />
    <param name="image_height" value="$(arg height)" />
    <param name="framerate" value="$(arg fps)" />
    <remap from="~image_raw" to="/camera/image_raw_unrotated" />
  </node>

  <node pkg="usb_camera" type="rotate_image.py" name="camera_rotate_180"
        output="screen">
    <remap from="image_in" to="/camera/image_raw_unrotated" />
    <remap from="image_out" to="/camera/image_raw" />
  </node>

  <node if="$(arg preview)" pkg="image_view" type="image_view"
        name="camera_preview" output="screen">
    <remap from="image" to="/camera/image_raw" />
  </node>
</launch>
