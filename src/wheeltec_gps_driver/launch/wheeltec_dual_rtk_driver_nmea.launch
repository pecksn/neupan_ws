<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="port" default="/dev/wheeltec_gnss" />
  <arg name="baud" default="115200" />
  <arg name="frame_id" default="navsat_link" />
  <arg name="time_ref_source" default="gps" />
  <arg name="useRMC" default="False" />
  <arg name="use_GNSS_time" default="False" />
  <!-- Shadow records receiver epochs but leaves navigation headers unchanged. -->
  <arg name="time_mode" default="shadow" />
  <arg name="time_clock_verified" default="false" />
  <arg name="pvt_period_sec" default="1.0" />
  <arg name="gga_period_sec" default="0.05" />
  <arg name="cadence_margin_sec" default="0.3" />
  <arg name="heading_source_is_north_cw" default="true" />
  <arg name="require_heading_fixed" default="true" />
  <arg name="solution_timeout_sec" default="2.5" />
  <arg name="serial_diagnostics_print" default="false" />
  <!-- 天线前后安装时 -->
  <!-- <arg name="rotation" default="0.0" /> -->
  <!-- 天线左右安装时 -->
  <arg name="rotation" default="90.0" />

  <node name="nmea_serial_driver_node" pkg="wheeltec_gps_driver" type="nmea_serial_driver" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="baud" value="$(arg baud)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="time_ref_source" value="$(arg time_ref_source)" />
    <param name="useRMC" value="$(arg useRMC)" />
    <param name="use_GNSS_time" value="$(arg use_GNSS_time)" />
    <param name="time_mode" value="$(arg time_mode)" />
    <param name="time_clock_verified" value="$(arg time_clock_verified)" />
    <param name="pvt_period_sec" value="$(arg pvt_period_sec)" />
    <param name="gga_period_sec" value="$(arg gga_period_sec)" />
    <param name="cadence_margin_sec" value="$(arg cadence_margin_sec)" />
    <param name="rotation" value="$(arg rotation)" />
    <param name="heading_source_is_north_cw" value="$(arg heading_source_is_north_cw)" />
    <param name="require_heading_fixed" value="$(arg require_heading_fixed)" />
    <param name="solution_timeout_sec" value="$(arg solution_timeout_sec)" />
    <param name="serial_diagnostics_print" value="$(arg serial_diagnostics_print)" />

  </node>
</launch>
