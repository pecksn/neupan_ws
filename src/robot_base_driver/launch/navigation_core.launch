<launch>
    <!-- true: 室外融合GPS，false: 室内仅里程计/LIO -->
    <arg name="outdoor_mode" default="true" />
    <arg name="imu_topic" default="/imu/data" />
    <arg name="use_fixed_datum" default="false" />
    <arg name="datum_lat" default="23.0398" />
    <arg name="datum_lon" default="113.39002" />
    <arg name="datum_yaw" default="0.0" />
    <arg name="navsat_delay" default="0.60" />
    <arg name="navsat_transform_timeout" default="1.00" />
    <arg name="outdoor_ekf_tf_time_offset" default="0.0" />

    <!-- 串口&底盘参数 -->
    <arg name="port" default="/dev/ttyUSB0"/>
    <arg name="baudrate" default="115200"/>
    <arg name="base_frame" default="base_link"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="wheelbase" default="0.67"/>
    <arg name="gps_frame" default="gps_link"/>
    <arg name="gps_cov_xy" default="9.0"/>
    <arg name="gps_cov_z" default="25.0"/>
    <arg name="gps_jump_reject_m" default="30.0"/>
    <arg name="gps_max_speed_mps" default="20.0"/>
    <arg name="gps_filter_window" default="5"/>
    <arg name="gps_stationary_speed_mps" default="0.15"/>
    <arg name="gps_stationary_jump_m" default="4.0"/>
    <arg name="gps_cov_stationary_scale" default="2.5"/>
    <arg name="gps_ema_alpha" default="0.35"/>
    <arg name="gps_warmup_samples" default="8"/>
    <arg name="gps_use_odom_stamp" default="true"/>
    <arg name="gps_stamp_max_age_sec" default="0.25"/>
    <arg name="use_global_ekf" default="false" />
    <arg name="publish_static_map_odom_outdoor" default="true" />

    <!-- 1) 底盘驱动：发布 /odom 与 /gps/fix -->
    <include file="$(find robot_base_driver)/launch/driver.launch">
        <arg name="port" value="$(arg port)"/>
        <arg name="baudrate" value="$(arg baudrate)"/>
        <arg name="base_frame" value="$(arg base_frame)"/>
        <arg name="odom_frame" value="$(arg odom_frame)"/>
        <arg name="wheelbase" value="$(arg wheelbase)"/>
        <arg name="publish_tf" value="false" />
        <arg name="gps_frame" value="$(arg gps_frame)"/>
        <arg name="gps_cov_xy" value="$(arg gps_cov_xy)"/>
        <arg name="gps_cov_z" value="$(arg gps_cov_z)"/>
        <arg name="gps_jump_reject_m" value="$(arg gps_jump_reject_m)"/>
        <arg name="gps_max_speed_mps" value="$(arg gps_max_speed_mps)"/>
        <arg name="gps_filter_window" value="$(arg gps_filter_window)"/>
        <arg name="gps_stationary_speed_mps" value="$(arg gps_stationary_speed_mps)"/>
        <arg name="gps_stationary_jump_m" value="$(arg gps_stationary_jump_m)"/>
        <arg name="gps_cov_stationary_scale" value="$(arg gps_cov_stationary_scale)"/>
        <arg name="gps_ema_alpha" value="$(arg gps_ema_alpha)"/>
        <arg name="gps_warmup_samples" value="$(arg gps_warmup_samples)"/>
        <arg name="gps_use_odom_stamp" value="$(arg gps_use_odom_stamp)"/>
        <arg name="gps_stamp_max_age_sec" value="$(arg gps_stamp_max_age_sec)"/>
    </include>

    <!-- 2) 本地EKF：融合 /odom + /Odometry，产出 /odometry/local -->
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_local" clear_params="true" output="screen">
        <rosparam command="load" file="$(find robot_base_driver)/config/ekf_local.yaml" />
        <param if="$(arg outdoor_mode)" name="transform_time_offset" value="$(arg outdoor_ekf_tf_time_offset)" />
        <remap from="odometry/filtered" to="/odometry/local" />
    </node>

    <!-- 3) 室外：GPS转里程计 + 全局EKF -->
    <group if="$(arg outdoor_mode)">
        <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform" clear_params="true" output="screen">
            <remap from="gps/fix" to="/gps/fix" />
            <remap from="imu/data" to="$(arg imu_topic)" />
            <remap from="odometry/filtered" to="/odometry/local" />
            <param name="frequency" value="30" />
            <param name="delay" value="$(arg navsat_delay)" />
            <param name="transform_timeout" value="$(arg navsat_transform_timeout)" />
            <param name="wait_for_datum" value="$(arg use_fixed_datum)" />
            <rosparam if="$(arg use_fixed_datum)" param="datum" subst_value="true">[$(arg datum_lat), $(arg datum_lon), $(arg datum_yaw)]</rosparam>
            <param name="zero_altitude" value="true" />
            <param name="publish_filtered_gps" value="true" />
            <param name="use_odometry_yaw" value="true" />
            <param name="broadcast_cartesian_transform" value="false" />
            <param name="broadcast_cartesian_transform_as_parent_frame" value="false" />
        </node>

        <group if="$(arg use_global_ekf)">
            <node pkg="robot_localization" type="ekf_localization_node" name="ekf_global" clear_params="true" output="screen">
                <rosparam command="load" file="$(find robot_base_driver)/config/ekf_global.yaml" />
                <param name="transform_time_offset" value="$(arg outdoor_ekf_tf_time_offset)" />
                <param name="publish_tf" value="true" />
                <remap from="odometry/filtered" to="/odometry/global" />
            </node>
        </group>

        <group unless="$(arg use_global_ekf)">
            <!-- 稳定模式：直接使用 navsat 输出作为全局里程计，避免全局EKF发散 -->
            <node pkg="robot_base_driver" type="global_odom_bridge.py" name="global_odom_bridge" output="screen">
                <param name="input_topic" value="/odometry/gps" />
                <param name="output_topic" value="/odometry/global" />
                <param name="output_frame" value="map" />
                <param name="child_frame" value="base_link" />
            </node>
            <group if="$(arg publish_static_map_odom_outdoor)">
                <node pkg="tf" type="static_transform_publisher" name="map_to_odom_outdoor" args="0 0 0 0 0 0 map odom 100" />
            </group>
        </group>
    </group>

    <!-- 4) 室内：给 map->odom 固定变换，方便全局规划使用 map 坐标 -->
    <arg name="publish_static_map_odom" default="true" />
    <group unless="$(arg outdoor_mode)">
        <group if="$(arg publish_static_map_odom)">
            <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom 100" />
        </group>
    </group>
</launch>
