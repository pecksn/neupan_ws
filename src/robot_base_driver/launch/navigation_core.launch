<launch>
    <!-- true: 室外融合GPS，false: 室内仅里程计/LIO -->
    <arg name="outdoor_mode" default="true" />
    <arg name="datum_lat" default="23.0398" />
    <arg name="datum_lon" default="113.39002" />
    <arg name="gps_map_projection_rate" default="30.0" />
    <arg name="outdoor_ekf_tf_time_offset" default="0.0" />
    <!-- FAST-LIO 输出级保护；FAST-LIO 内部滤波后仍可能在桥底退化。 -->
    <arg name="lio_guard_max_speed" default="2.0" />
    <arg name="lio_guard_max_lateral_speed" default="0.8" />
    <arg name="lio_guard_max_yaw_rate_deg" default="90.0" />
    <arg name="lio_guard_max_sample_gap" default="0.5" />
    <arg name="lio_guard_recovery_stable_sec" default="2.0" />

    <!-- 串口&底盘参数 -->
    <arg name="port" default="/dev/robot_base"/>
    <arg name="baudrate" default="115200"/>
    <arg name="base_frame" default="base_link"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="wheelbase" default="0.67"/>
    <arg name="wheel_radius" default="0.1275"/>
    <arg name="max_forward_speed_mps" default="1.5"/>
    <arg name="max_reverse_speed_mps" default="1.5"/>
    <arg name="cmd_topic" default="/neupan_cmd_vel"/>
    <arg name="gps_frame" default="gps_link"/>
    <arg name="gps_port" default="/dev/wheeltec_gnss" />
    <arg name="gps_baud" default="115200" />
    <arg name="gps_time_ref_source" default="gps" />
    <arg name="gps_use_rmc" default="false" />
    <arg name="gps_rotation" default="90.0" />
    <arg name="gps_use_gnss_time" default="false" />
    <arg name="gps_time_mode" default="shadow" />
    <arg name="gps_time_clock_verified" default="false" />
    <arg name="gps_pvt_period_sec" default="1.0" />
    <arg name="gps_transport_limit_sec" default="0.0" />
    <arg name="gps_common_utc_verified" default="false" />
    <arg name="gps_raw_capture_sec" default="0.0" />
    <arg name="gps_gga_period_sec" default="0.05" />
    <arg name="gps_cadence_margin_sec" default="0.3" />
    <arg name="gps_heading_source_is_north_cw" default="true" />
    <arg name="use_global_ekf" default="false" />
    <!-- Fail during launch parsing, before starting any node: the legacy
         global EKF does not implement this measurement-time safety contract. -->
    <arg name="gps_time_mode_validated" default="$(eval {'allowed': arg('gps_time_mode')}['unsupported_measurement_with_global_ekf' if arg('gps_time_mode') == 'measurement' and arg('use_global_ekf') else 'allowed'])" />
    <arg name="publish_static_map_odom_outdoor" default="true" />
    <arg name="global_odom_use_heading" default="true" />
    <arg name="global_odom_heading_filter_window_sec" default="10.0" />
    <arg name="global_odom_heading_topic" default="/heading" />
    <arg name="global_odom_heading_timeout" default="0.5" />
    <!-- G90弱信号保护：RTK不可信时使用本地FAST-LIO续推，恢复后平滑校正。 -->
    <arg name="gps_guard_enable" default="true" />
    <arg name="low_precision_startup" default="false" />
    <arg name="gps_guard_allow_nonfixed_runtime" default="false" />
    <arg name="gps_guard_runtime_position_max_covariance" default="4.0" />
    <arg name="gps_guard_runtime_position_max_hdop" default="2.5" />
    <arg name="gps_guard_runtime_position_min_satellites" default="8" />
    <arg name="gps_guard_runtime_position_stable_sec" default="5.0" />
    <arg name="gps_guard_runtime_position_consistency_m" default="0.75" />
    <arg name="gps_guard_runtime_position_max_error_m" default="3.0" />
    <arg name="gps_guard_runtime_position_correction_rate" default="0.10" />
    <arg name="gps_guard_min_fix_status" default="2" />
    <arg name="gps_guard_required_gga_quality" default="4" />
    <arg name="gps_guard_min_satellites" default="8" />
    <arg name="gps_guard_max_hdop" default="1.5" />
    <arg name="gps_guard_max_position_covariance" default="0.25" />
    <arg name="gps_guard_heading_jump_limit_deg" default="8.0" />
    <arg name="gps_guard_max_tracking_position_error" default="0.5" />
    <arg name="gps_guard_max_tracking_candidate_step" default="0.35" />
    <arg name="gps_guard_max_tracking_yaw_error_deg" default="20.0" />
    <arg name="gps_guard_initial_stable_sec" default="2.0" />
    <arg name="gps_guard_recovery_stable_sec" default="4.0" />
    <arg name="gps_guard_recovery_position_rate" default="0.5" />
    <arg name="gps_guard_recovery_yaw_rate_deg" default="8.0" />
    <arg name="gps_guard_local_max_speed" default="2.0" />
    <arg name="gps_guard_local_max_lateral_speed" default="0.8" />
    <arg name="gps_guard_local_max_yaw_rate_deg" default="90.0" />
    <arg name="gps_guard_local_fault_hold_sec" default="2.0" />
    <arg name="gps_guard_dead_reckoning_max_distance_m" default="100.0" />
    <arg name="gps_guard_dead_reckoning_max_duration_sec" default="600.0" />
    <arg name="enable_localization_safety_stop" default="false" />
    <!-- MOTOR 报警阈值；扭矩单位需与下位机上报单位一致，温度单位为摄氏度。 -->
    <arg name="motor_torque_limit" default="7.0" />
    <arg name="motor_mos_temp_limit" default="100.0" />
    <arg name="motor_coil_temp_limit" default="90.0" />
    <arg name="motor_torque_hysteresis" default="0.5" />
    <arg name="motor_temp_hysteresis" default="5.0" />

    <!-- 1) 底盘驱动：仅发布 /odom -->
    <include file="$(find robot_base_driver)/launch/driver.launch">
        <arg name="port" value="$(arg port)"/>
        <arg name="baudrate" value="$(arg baudrate)"/>
        <arg name="base_frame" value="$(arg base_frame)"/>
        <arg name="odom_frame" value="$(arg odom_frame)"/>
        <arg name="wheelbase" value="$(arg wheelbase)"/>
        <arg name="wheel_radius" value="$(arg wheel_radius)"/>
        <arg name="max_forward_speed_mps" value="$(arg max_forward_speed_mps)"/>
        <arg name="max_reverse_speed_mps" value="$(arg max_reverse_speed_mps)"/>
        <arg name="cmd_topic" value="$(arg cmd_topic)"/>
        <arg name="publish_tf" value="false" />
        <arg name="enable_localization_safety_stop" value="$(arg enable_localization_safety_stop)" />
        <arg name="motor_torque_limit" value="$(arg motor_torque_limit)" />
        <arg name="motor_mos_temp_limit" value="$(arg motor_mos_temp_limit)" />
        <arg name="motor_coil_temp_limit" value="$(arg motor_coil_temp_limit)" />
        <arg name="motor_torque_hysteresis" value="$(arg motor_torque_hysteresis)" />
        <arg name="motor_temp_hysteresis" value="$(arg motor_temp_hysteresis)" />
    </include>

    <!-- 2) 室外时启用上位机 G90 NMEA，发布 /gps/fix -->
    <group if="$(arg outdoor_mode)">
        <include file="$(find robot_base_driver)/launch/g90_nmea.launch">
            <arg name="gps_port" value="$(arg gps_port)" />
            <arg name="gps_baud" value="$(arg gps_baud)" />
            <arg name="gps_frame" value="$(arg gps_frame)" />
            <arg name="time_ref_source" value="$(arg gps_time_ref_source)" />
            <arg name="use_rmc" value="$(arg gps_use_rmc)" />
            <arg name="gps_rotation" value="$(arg gps_rotation)" />
            <arg name="use_gnss_time" value="$(arg gps_use_gnss_time)" />
            <arg name="gps_time_mode" value="$(arg gps_time_mode)" />
            <arg name="gps_time_clock_verified" value="$(arg gps_time_clock_verified)" />
            <arg name="gps_pvt_period_sec" value="$(arg gps_pvt_period_sec)" />
            <arg name="gps_transport_limit_sec" value="$(arg gps_transport_limit_sec)" />
            <arg name="gps_common_utc_verified" value="$(arg gps_common_utc_verified)" />
            <arg name="gps_raw_capture_sec" value="$(arg gps_raw_capture_sec)" />
            <arg name="gps_gga_period_sec" value="$(arg gps_gga_period_sec)" />
            <arg name="gps_cadence_margin_sec" value="$(arg gps_cadence_margin_sec)" />
            <arg name="heading_source_is_north_cw" value="$(arg gps_heading_source_is_north_cw)" />
        </include>
    </group>

    <!-- 3) FAST-LIO 跳变保护：异常时停止向 EKF 注入 LIO，恢复时保持 SE(2) 连续。 -->
    <node pkg="robot_base_driver" type="lio_odom_guard.py" name="lio_odom_guard" output="screen">
        <param name="input_topic" value="/Odometry" />
        <param name="wheel_topic" value="/odom" />
        <param name="output_topic" value="/odometry/lio_guarded" />
        <param name="status_topic" value="/lio_guard/status" />
        <param name="healthy_topic" value="/lio_guard/healthy" />
        <param name="max_speed" value="$(arg lio_guard_max_speed)" />
        <param name="max_lateral_speed" value="$(arg lio_guard_max_lateral_speed)" />
        <param name="max_yaw_rate_deg" value="$(arg lio_guard_max_yaw_rate_deg)" />
        <param name="max_sample_gap" value="$(arg lio_guard_max_sample_gap)" />
        <param name="recovery_stable_sec" value="$(arg lio_guard_recovery_stable_sec)" />
    </node>

    <!-- 4) 本地EKF：融合 /odom + 受保护FAST-LIO，产出 /odometry/local。
         不重复融合 /livox/imu，因为 FAST-LIO 已经使用了同一颗 IMU。 -->
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_local" clear_params="true" output="screen">
        <rosparam command="load" file="$(find robot_base_driver)/config/ekf_local.yaml" />
        <param if="$(arg outdoor_mode)" name="transform_time_offset" value="$(arg outdoor_ekf_tf_time_offset)" />
        <remap from="odometry/filtered" to="/odometry/local" />
    </node>

    <!-- 5) 室外：GPS转里程计 + 全局EKF
         /odometry/gps 必须和 OSM A* 使用同一套经纬度->map投影。
         之前使用 navsat_transform 会引入 odom/datum/yaw/TF 相关坐标基准，
         导致GPS点和OSM蓝线出现稳定米级偏移。 -->
    <group if="$(arg outdoor_mode)">
        <node pkg="robot_base_driver" type="gps_fix_to_map_odom.py" name="gps_fix_to_map_odom" clear_params="true" output="screen">
            <param name="gps_time_mode" value="$(arg gps_time_mode)" />
            <param name="gps_time_clock_verified" value="$(arg gps_time_clock_verified)" />
            <param name="gnss_transport_limit_sec" value="$(arg gps_transport_limit_sec)" />
            <param name="gnss_common_utc_verified" value="$(arg gps_common_utc_verified)" />
            <param name="gga_period_sec" value="$(arg gps_gga_period_sec)" />
            <param name="cadence_margin_sec" value="$(arg gps_cadence_margin_sec)" />
            <param name="fix_topic" value="/gps/fix" />
            <param name="heading_topic" value="$(arg global_odom_heading_topic)" />
            <param name="output_topic" value="/odometry/gps" />
            <param name="frame_id" value="map" />
            <param name="child_frame_id" value="$(arg base_frame)" />
            <param name="origin_lat" value="$(arg datum_lat)" />
            <param name="origin_lon" value="$(arg datum_lon)" />
            <param name="zero_altitude" value="true" />
            <param name="use_heading" value="$(arg global_odom_use_heading)" />
            <param name="heading_timeout_sec" value="$(arg global_odom_heading_timeout)" />
            <param name="publish_rate" value="$(arg gps_map_projection_rate)" />
        </node>

        <group if="$(arg use_global_ekf)">
            <node pkg="robot_localization" type="ekf_localization_node" name="ekf_global" clear_params="true" output="screen">
                <rosparam command="load" file="$(find robot_base_driver)/config/ekf_global.yaml" />
                <param name="transform_time_offset" value="$(arg outdoor_ekf_tf_time_offset)" />
                <param name="publish_tf" value="true" />
                <remap from="odometry/filtered" to="/odometry/global" />
            </node>
        </group>

        <group unless="$(arg use_global_ekf)">
            <!-- 稳定模式：使用OSM一致投影后的GPS里程计，并在GPS异常时由本地里程计续推。 -->
            <node pkg="robot_base_driver" type="global_odom_bridge.py" name="global_odom_bridge" output="screen">
                <param name="gps_time_mode" value="$(arg gps_time_mode)" />
                <param name="gps_time_clock_verified" value="$(arg gps_time_clock_verified)" />
                <param name="gnss_transport_limit_sec" value="$(arg gps_transport_limit_sec)" />
                <param name="gnss_common_utc_verified" value="$(arg gps_common_utc_verified)" />
                <param name="input_topic" value="/odometry/gps" />
                <param name="local_topic" value="/odometry/local" />
                <param name="fix_topic" value="/gps/fix" />
                <param name="gga_topic" value="/gnss/gpgga" />
                <param name="output_topic" value="/odometry/global" />
                <param name="status_topic" value="/gps_guard/status" />
                <param name="safety_topic" value="/localization_safe" />
                <param name="output_frame" value="map" />
                <param name="child_frame" value="base_link" />
                <param name="use_heading_orientation" value="$(arg global_odom_use_heading)" />
                <param name="heading_filter_window_sec" value="$(arg global_odom_heading_filter_window_sec)" />
                <param name="heading_topic" value="$(arg global_odom_heading_topic)" />
                <param name="heading_timeout_sec" value="$(arg global_odom_heading_timeout)" />
                <param name="pvt_period_sec" value="$(arg gps_pvt_period_sec)" />
                <param name="gga_period_sec" value="$(arg gps_gga_period_sec)" />
                <param name="cadence_margin_sec" value="$(arg gps_cadence_margin_sec)" />
                <param name="guard_enabled" value="$(arg gps_guard_enable)" />
                <param name="low_precision_startup" value="$(arg low_precision_startup)" />
                <param name="allow_nonfixed_runtime" value="$(arg gps_guard_allow_nonfixed_runtime)" />
                <param name="runtime_position_max_covariance" value="$(arg gps_guard_runtime_position_max_covariance)" />
                <param name="runtime_position_max_hdop" value="$(arg gps_guard_runtime_position_max_hdop)" />
                <param name="runtime_position_min_satellites" value="$(arg gps_guard_runtime_position_min_satellites)" />
                <param name="runtime_position_stable_sec" value="$(arg gps_guard_runtime_position_stable_sec)" />
                <param name="runtime_position_consistency_m" value="$(arg gps_guard_runtime_position_consistency_m)" />
                <param name="runtime_position_max_error_m" value="$(arg gps_guard_runtime_position_max_error_m)" />
                <param name="runtime_position_correction_rate" value="$(arg gps_guard_runtime_position_correction_rate)" />
                <param name="min_fix_status" value="$(arg gps_guard_min_fix_status)" />
                <param name="required_gga_quality" value="$(arg gps_guard_required_gga_quality)" />
                <param name="min_satellites" value="$(arg gps_guard_min_satellites)" />
                <param name="max_hdop" value="$(arg gps_guard_max_hdop)" />
                <param name="max_position_covariance" value="$(arg gps_guard_max_position_covariance)" />
                <param name="heading_jump_limit_deg" value="$(arg gps_guard_heading_jump_limit_deg)" />
                <param name="max_tracking_position_error" value="$(arg gps_guard_max_tracking_position_error)" />
                <param name="max_tracking_candidate_step" value="$(arg gps_guard_max_tracking_candidate_step)" />
                <param name="max_tracking_yaw_error_deg" value="$(arg gps_guard_max_tracking_yaw_error_deg)" />
                <param name="initial_stable_sec" value="$(arg gps_guard_initial_stable_sec)" />
                <param name="recovery_stable_sec" value="$(arg gps_guard_recovery_stable_sec)" />
                <param name="recovery_position_rate" value="$(arg gps_guard_recovery_position_rate)" />
                <param name="recovery_yaw_rate_deg" value="$(arg gps_guard_recovery_yaw_rate_deg)" />
                <param name="local_max_speed" value="$(arg gps_guard_local_max_speed)" />
                <param name="local_max_lateral_speed" value="$(arg gps_guard_local_max_lateral_speed)" />
                <param name="local_max_yaw_rate_deg" value="$(arg gps_guard_local_max_yaw_rate_deg)" />
                <param name="local_fault_hold_sec" value="$(arg gps_guard_local_fault_hold_sec)" />
                <param name="dead_reckoning_max_distance_m" value="$(arg gps_guard_dead_reckoning_max_distance_m)" />
                <param name="dead_reckoning_max_duration_sec" value="$(arg gps_guard_dead_reckoning_max_duration_sec)" />
            </node>
            <group if="$(arg publish_static_map_odom_outdoor)">
                <node pkg="tf" type="static_transform_publisher" name="map_to_odom_outdoor" args="0 0 0 0 0 0 map odom 100" />
            </group>
        </group>
    </group>

    <!-- 6) 室内：给 map->odom 固定变换，方便全局规划使用 map 坐标 -->
    <arg name="publish_static_map_odom" default="true" />
    <group unless="$(arg outdoor_mode)">
        <group if="$(arg publish_static_map_odom)">
            <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom 100" />
        </group>
    </group>
</launch>
