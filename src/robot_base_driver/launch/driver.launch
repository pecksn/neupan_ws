<launch>
    <!-- 串口参数 -->
    <arg name="port" default="/dev/ttyUSB0"/>
    <arg name="baudrate" default="115200"/>

    <!-- 机器人参数 -->
    <arg name="wheelbase" default="0.67"/>
    <arg name="wheel_radius" default="0.1275"/>

    <!-- 坐标系参数 -->
    <arg name="base_frame" default="base_link"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="publish_tf" default="true"/>
    <arg name="gps_frame" default="gps_link"/>
    <arg name="gps_cov_xy" default="9.0"/>
    <arg name="gps_cov_z" default="25.0"/>
    <arg name="gps_jump_reject_m" default="30.0"/>
    <arg name="gps_max_speed_mps" default="20.0"/>
    <arg name="gps_filter_window" default="5"/>
    <arg name="gps_stationary_speed_mps" default="0.15"/>
    <arg name="gps_stationary_jump_m" default="4.0"/>
    <arg name="gps_cov_stationary_scale" default="2.5"/>
    <arg name="gps_ema_alpha" default="0.35"/>
    <arg name="gps_warmup_samples" default="8"/>
    <arg name="gps_use_odom_stamp" default="true"/>
    <arg name="gps_stamp_max_age_sec" default="0.25"/>

    <!-- 启动底盘驱动节点 -->
    <node pkg="robot_base_driver" type="base_driver_node.py" name="robot_base_driver" output="screen">
        <param name="port" value="$(arg port)"/>
        <param name="baudrate" value="$(arg baudrate)"/>
        <param name="wheelbase" value="$(arg wheelbase)"/>
        <param name="wheel_radius" value="$(arg wheel_radius)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="publish_tf" value="$(arg publish_tf)"/>
        <param name="gps_frame" value="$(arg gps_frame)"/>
        <param name="gps_cov_xy" value="$(arg gps_cov_xy)"/>
        <param name="gps_cov_z" value="$(arg gps_cov_z)"/>
        <param name="gps_jump_reject_m" value="$(arg gps_jump_reject_m)"/>
        <param name="gps_max_speed_mps" value="$(arg gps_max_speed_mps)"/>
        <param name="gps_filter_window" value="$(arg gps_filter_window)"/>
        <param name="gps_stationary_speed_mps" value="$(arg gps_stationary_speed_mps)"/>
        <param name="gps_stationary_jump_m" value="$(arg gps_stationary_jump_m)"/>
        <param name="gps_cov_stationary_scale" value="$(arg gps_cov_stationary_scale)"/>
        <param name="gps_ema_alpha" value="$(arg gps_ema_alpha)"/>
        <param name="gps_warmup_samples" value="$(arg gps_warmup_samples)"/>
        <param name="gps_use_odom_stamp" value="$(arg gps_use_odom_stamp)"/>
        <param name="gps_stamp_max_age_sec" value="$(arg gps_stamp_max_age_sec)"/>
    </node>

    <!-- 静态 TF 发布: base_link 到 laser_link -->
    <!-- 根据实际安装位置修改 args: x y z yaw pitch roll -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_laser" args="0.1 0 0.5 0 0 0 base_link laser_link 100" />
</launch>