<launch>
    <arg name="gps_port" default="/dev/wheeltec_gnss" />
    <arg name="gps_baud" default="115200" />
    <arg name="gps_frame" default="gps_link" />
    <arg name="time_ref_source" default="gps" />
    <arg name="use_rmc" default="false" />
    <arg name="gps_rotation" default="90.0" />
    <arg name="use_gnss_time" default="false" />
    <arg name="gps_time_mode" default="shadow" />
    <arg name="gps_time_clock_verified" default="false" />
    <arg name="gps_pvt_period_sec" default="1.0" />
    <arg name="gps_transport_limit_sec" default="0.0" />
    <arg name="gps_common_utc_verified" default="false" />
    <arg name="gps_raw_capture_sec" default="0.0" />
    <arg name="gps_gga_period_sec" default="0.05" />
    <arg name="gps_cadence_margin_sec" default="0.3" />
    <arg name="heading_source_is_north_cw" default="true" />
    <arg name="require_heading_fixed" default="true" />
    <arg name="solution_timeout_sec" default="2.5" />

    <include file="$(find wheeltec_gps_driver)/launch/wheeltec_dual_rtk_driver_nmea.launch">
        <arg name="port" value="$(arg gps_port)" />
        <arg name="baud" value="$(arg gps_baud)" />
        <arg name="frame_id" value="$(arg gps_frame)" />
        <arg name="time_ref_source" value="$(arg time_ref_source)" />
        <arg name="useRMC" value="$(arg use_rmc)" />
        <arg name="use_GNSS_time" value="$(arg use_gnss_time)" />
        <arg name="time_mode" value="$(arg gps_time_mode)" />
        <arg name="time_clock_verified" value="$(arg gps_time_clock_verified)" />
        <arg name="pvt_period_sec" value="$(arg gps_pvt_period_sec)" />
        <arg name="gnss_transport_limit_sec" value="$(arg gps_transport_limit_sec)" />
        <arg name="gnss_common_utc_verified" value="$(arg gps_common_utc_verified)" />
        <arg name="raw_capture_sec" value="$(arg gps_raw_capture_sec)" />
        <arg name="gga_period_sec" value="$(arg gps_gga_period_sec)" />
        <arg name="cadence_margin_sec" value="$(arg gps_cadence_margin_sec)" />
        <arg name="rotation" value="$(arg gps_rotation)" />
        <arg name="heading_source_is_north_cw" value="$(arg heading_source_is_north_cw)" />
        <arg name="require_heading_fixed" value="$(arg require_heading_fixed)" />
        <arg name="solution_timeout_sec" value="$(arg solution_timeout_sec)" />
    </include>
</launch>
