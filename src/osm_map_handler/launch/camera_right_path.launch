<launch>
  <arg name="control_enabled" default="false" />
  <arg name="input_path_topic" default="/osm_global_path" />
  <arg name="center_clearance_m" default="-1" doc="旧中心距离覆盖参数；-1 使用轮胎距离换算" />
  <arg name="wheel_clearance_m" default="1.5" />
  <arg name="track_width_m" default="0.67" doc="用户确认的实车左右轮中心间距" />
  <arg name="tire_width_m" default="0.08" doc="胎宽暂取仿真估计，实车需确认" />
  <arg name="right_wheel_lateral_offset_m" default="-1" doc="中心到右轮外沿覆盖值；-1按轮距和胎宽计算" />
  <arg name="wheel_geometry_verified" default="false" />
  <arg name="strategy" default="segment_cache" />
  <arg name="min_confidence" default="0.60" />
  <arg name="timeout_sec" default="-1" doc="-1: segment_cache 0.8 s; realtime 0.5 s" />
  <arg name="max_source_age_ms" default="-1" doc="-1: segment_cache 500 ms; realtime 300 ms" />
  <arg name="max_capture_age_ms" default="-1" doc="-1: segment_cache 800 ms; realtime 500 ms" />
  <arg name="distance_reference" default="camera_center" />
  <arg name="camera_clearance_m" default="2.0" />
  <arg name="base_link_height_m" default="0.20" />
  <arg name="osm_file" default="/home/nuc/lxw/ros_maps/map.osm" />
  <arg name="map_origin_lat" default="23.0398" />
  <arg name="map_origin_lon" default="113.39002" />
  <node pkg="osm_map_handler" type="camera_right_path.py" name="camera_right_path" output="screen">
    <param name="control_enabled" value="$(arg control_enabled)" />
    <param name="input_path_topic" value="$(arg input_path_topic)" />
    <param name="center_clearance_m" value="$(arg center_clearance_m)" />
    <param name="wheel_clearance_m" value="$(arg wheel_clearance_m)" />
    <param name="track_width_m" value="$(arg track_width_m)" />
    <param name="tire_width_m" value="$(arg tire_width_m)" />
    <param name="right_wheel_lateral_offset_m" value="$(arg right_wheel_lateral_offset_m)" />
    <param name="wheel_geometry_verified" value="$(arg wheel_geometry_verified)" />
    <param name="strategy" value="$(arg strategy)" />
    <param name="min_confidence" value="$(arg min_confidence)" />
    <param name="timeout_sec" value="$(arg timeout_sec)" />
    <param name="max_source_age_ms" value="$(arg max_source_age_ms)" />
    <param name="max_capture_age_ms" value="$(arg max_capture_age_ms)" />
    <param name="distance_reference" value="$(arg distance_reference)" />
    <param name="camera_clearance_m" value="$(arg camera_clearance_m)" />
    <param name="base_link_height_m" value="$(arg base_link_height_m)" />
    <param name="osm_file" value="$(arg osm_file)" />
    <param name="map_origin_lat" value="$(arg map_origin_lat)" />
    <param name="map_origin_lon" value="$(arg map_origin_lon)" />
    <param name="camera_info_file" value="$(find usb_camera)/config/usb_camera.yaml" />
    <param name="extrinsics_file" value="$(find usb_camera)/config/livox_camera_extrinsics.yaml" />
  </node>
</launch>
